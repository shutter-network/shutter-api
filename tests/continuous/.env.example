# Continuous round monitor. Copy to .env and fill in.
# .env is gitignored by the root .gitignore, .env.example is not.

# --- Required. No defaults on purpose, so a run cannot silently hit the wrong
# --- network.
API_BASE_URL=
API_SIGNER_ADDRESS=

# Bearer token from data/keys.csv on the API host. Without one you hit the
# unauthenticated limits (20 get_decryption_key per day) and the run dies partway
# through round two. Use one of your OWN tokens, not a customer's — a 24h run would
# otherwise consume their daily quota.
API_AUTH_TOKEN=

# --- Run shape ---

# 0 runs until the process is stopped, which is the standing-monitor mode.
# 26h for a day-long soak. 2m for a shakedown.
TEST_DURATION=0

# Minimum gap between round STARTS, not a fixed schedule. A round takes at least
# DECRYPTION_LEAD, so with these two equal, rounds run effectively back to back.
ROUND_INTERVAL=1m

# How far ahead of now the decryption timestamp is set. Minimum 15s: a registration
# needs roughly one block to become queryable, and a shorter lead reports failures
# that aren't real.
DECRYPTION_LEAD=1m

# --- Polling. Only starts AFTER the decryption timestamp, which keeps a 24h run to
# --- a few thousand reads rather than ~17,000.
POLL_INTERVAL=2s
POLL_TIMEOUT=2m

# --- Metrics ---

# Port for the /metrics endpoint a vmagent scrapes, the same pattern the keypers use.
# 0 disables the endpoint entirely — the monitor still logs every round, which is the
# right setting for a first run.
#
# instance / network / deployment / deployment_type labels are applied by vmagent,
# not here, so there is no NETWORK variable to set.
METRICS_PORT=9300

# --- Verdict ---

# Failed rounds tolerated before the test reports failure. A long soak may reasonably
# accept one or two transient failures; 0 means any failure fails the run.
ALLOWED_FAILURES=0