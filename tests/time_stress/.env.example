# Time-based API stress runner — environment template.
#
# Copy to .env and fill in the required values. See README.md for the full table
# of knobs and recommended starting loads.

# ---- Required ----

# The deployed API to point at. No default is set in code on purpose, so a run
# cannot silently hit the wrong network.
API_BASE_URL=https://shutter-api.chiado.staging.shutter.network

# The API's own signer. Identities derive from this address, so it must be the
# API's — not yours.
#   Chiado: 0xd150bbf86C686de1a25820A94c2C2397e0bC54ab
#   Gnosis: 0x228DefCF37Da29475F0EE2B9E4dfAeDc3b0746bc
API_SIGNER_ADDRESS=0xd150bbf86C686de1a25820A94c2C2397e0bC54ab

# ---- Auth ----

# Bearer token. Chiado is unlimited, so an empty value is fine there. On Gnosis,
# unauthenticated limits are tiny (20 get_decryption_key per day) — any real
# stress run needs a dedicated / premium key or it dies in seconds.
API_AUTH_TOKEN=

# ---- What to run ----

# "full" or "read-only".
#   full:      end-to-end round (register, encrypt, poll, decrypt, verify).
#              Correctness under load. Bounded by on-chain tx throughput.
#   read-only: pre-register a pool, then loop get_data + get_decryption_key.
#              The mode to use when stressing the API read path and the LB
#              behind it, without the on-chain tx bottleneck.
STRESS_MODE=read-only

# Upper bound on in-flight rounds.
WORKERS=20

# Round starts per second, token-bucket paced. 0 means uncapped — workers loop
# as fast as the API allows.
TARGET_RPS=20

# 0 runs until the container is stopped. For a bounded soak set e.g. 10m, 2h.
TEST_DURATION=10m

# Failed rounds tolerated before the test wrapper reports failure. For an LB
# validation start with 0 and tune up only if failures turn out to be noise.
ALLOWED_FAILURES=0

# ---- Full-mode tuning (ignored in read-only) ----

# How far ahead to set the decryption timestamp. Minimum 15s — a shorter lead
# risks the registration not being visible on chain before the timestamp
# passes, which reports as a failure that isn't one.
DECRYPTION_LEAD=30s

# Gap between get_decryption_key polls, after the timestamp.
POLL_INTERVAL=2s

# Give up this long past the timestamp.
POLL_TIMEOUT=2m

# ---- Read-only pool setup (ignored in full mode) ----

# Number of pre-registered identities workers rotate over.
POOL_SIZE=10

# Decryption-timestamp lead used while building the pool. Same floor as
# DECRYPTION_LEAD.
POOL_SETUP_LEAD=45s

# Give up on pool setup if a key never arrives this long past its timestamp.
POOL_SETUP_POLL=3m

# ---- Transport ----

# Per-request timeout. A loadbalancer hiccup should surface as a slow request,
# not an immediate error.
HTTP_TIMEOUT=30s

# ---- Metrics ----

# /metrics port. 0 disables the endpoint; the runner still logs every round and
# prints a per-stage percentile report at the end. If you change this, update
# the port mapping in docker-compose.yml as well.
METRICS_PORT=9301

# Remote-write target used by the vmagent service, when the `pushmetrics`
# profile is enabled. Leave blank unless you are running vmagent — compose will
# otherwise warn on every command.
REMOTE_WRITE_URL=
